{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reengine/schemas/feature.schema.json",
  "title": "Canonical Feature Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "level",
    "description",
    "ruleset",
    "mechanics"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/contentId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "description": {
      "type": "string"
    },
    "ruleset": {
      "$ref": "common.schema.json#/$defs/ruleset"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "optional": {
      "type": "boolean",
      "default": false
    },
    "mechanics": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/selection"
          },
          {
            "$ref": "#/$defs/assignment"
          },
          {
            "$ref": "#/$defs/resourcePool"
          },
          {
            "$ref": "#/$defs/spellModifier"
          },
          {
            "$ref": "#/$defs/action"
          },
          {
            "$ref": "#/$defs/trigger"
          }
        ]
      }
    }
  },
  "$defs": {
    "progressionValue": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "fixed"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "tableId",
            "column"
          ],
          "properties": {
            "kind": {
              "const": "class-table"
            },
            "tableId": {
              "$ref": "common.schema.json#/$defs/contentId"
            },
            "levelFromClassId": {
              "$ref": "common.schema.json#/$defs/contentId"
            },
            "column": {
              "type": "string",
              "minLength": 1
            },
            "fallback": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "requirement": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "classId",
            "minimum"
          ],
          "properties": {
            "kind": {
              "const": "class-level"
            },
            "classId": {
              "$ref": "common.schema.json#/$defs/contentId"
            },
            "minimum": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "ability",
            "minimum"
          ],
          "properties": {
            "kind": {
              "const": "ability-score"
            },
            "ability": {
              "enum": [
                "str",
                "dex",
                "con",
                "int",
                "wis",
                "cha"
              ]
            },
            "minimum": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "selectionId",
            "optionId"
          ],
          "properties": {
            "kind": {
              "const": "known-option"
            },
            "selectionId": {
              "$ref": "common.schema.json#/$defs/contentId"
            },
            "optionId": {
              "$ref": "common.schema.json#/$defs/contentId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "spellId"
          ],
          "properties": {
            "kind": {
              "const": "spell-known"
            },
            "spellId": {
              "$ref": "common.schema.json#/$defs/contentId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "featureId"
          ],
          "properties": {
            "kind": {
              "const": "feature-owned"
            },
            "featureId": {
              "$ref": "common.schema.json#/$defs/contentId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "requirements"
          ],
          "properties": {
            "kind": {
              "enum": [
                "all",
                "any"
              ]
            },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/requirement"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "selection": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "optionSetId",
        "mode",
        "count"
      ],
      "properties": {
        "kind": {
          "const": "selection"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/contentId"
        },
        "optionSetId": {
          "$ref": "common.schema.json#/$defs/contentId"
        },
        "mode": {
          "enum": [
            "single",
            "multiple"
          ]
        },
        "count": {
          "$ref": "#/$defs/progressionValue"
        },
        "allowDuplicates": {
          "type": "boolean",
          "default": false
        },
        "replacement": {
          "type": "object",
          "required": [
            "when",
            "count"
          ],
          "properties": {
            "when": {
              "enum": [
                "class-level-gained",
                "long-rest",
                "manual"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "selectionId",
        "targetKind",
        "capacity",
        "maxPerTarget"
      ],
      "properties": {
        "kind": {
          "const": "assignment"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/contentId"
        },
        "selectionId": {
          "$ref": "common.schema.json#/$defs/contentId"
        },
        "targetKind": {
          "enum": [
            "inventory-item",
            "creature",
            "spell"
          ]
        },
        "capacity": {
          "$ref": "#/$defs/progressionValue"
        },
        "maxPerTarget": {
          "type": "integer",
          "minimum": 1
        },
        "maxPerOption": {
          "type": "integer",
          "minimum": 1
        },
        "resetOn": {
          "enum": [
            "short-rest",
            "long-rest",
            "never"
          ]
        },
        "eligibleItemTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "resourcePool": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "resourceId",
        "maximum",
        "recovery"
      ],
      "properties": {
        "kind": {
          "const": "resource-pool"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/contentId"
        },
        "resourceId": {
          "$ref": "common.schema.json#/$defs/contentId"
        },
        "maximum": {
          "$ref": "#/$defs/progressionValue"
        },
        "recovery": {
          "enum": [
            "short-rest",
            "long-rest",
            "dawn",
            "manual",
            "special"
          ]
        }
      },
      "additionalProperties": false
    },
    "spellModifier": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "optionSetId",
        "resourceId",
        "timing",
        "maxPerSpell"
      ],
      "properties": {
        "kind": {
          "const": "spell-modifier"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/contentId"
        },
        "optionSetId": {
          "$ref": "common.schema.json#/$defs/contentId"
        },
        "resourceId": {
          "$ref": "common.schema.json#/$defs/contentId"
        },
        "timing": {
          "const": "spell-cast"
        },
        "maxPerSpell": {
          "type": "integer",
          "minimum": 1
        },
        "replacement": {
          "type": "object",
          "required": [
            "when",
            "count"
          ],
          "properties": {
            "when": {
              "enum": [
                "class-level-gained",
                "manual"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "actionIds"
      ],
      "properties": {
        "kind": {
          "const": "action"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/contentId"
        },
        "actionIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/contentId"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "triggerIds"
      ],
      "properties": {
        "kind": {
          "const": "trigger"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/contentId"
        },
        "triggerIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/contentId"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
