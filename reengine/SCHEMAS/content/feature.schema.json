{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reengine/schemas/feature.schema.json",
  "title": "Canonical Feature Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "level", "description", "mechanics"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "level": { "type": "integer", "minimum": 0 },
    "description": { "type": "string" },
    "source": { "$ref": "#/$defs/source" },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "optional": { "type": "boolean", "default": false },
    "mechanics": {
      "type": "array",
      "items": { "oneOf": [
        { "$ref": "#/$defs/selection" },
        { "$ref": "#/$defs/assignment" },
        { "$ref": "#/$defs/resourcePool" },
        { "$ref": "#/$defs/spellModifier" }
      ] }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "book": { "type": "string" },
        "page": { "type": ["integer", "string"] },
        "publisher": { "type": "string" },
        "license": { "type": "string" }
      }
    },
    "progressionValue": {
      "oneOf": [
        { "type": "object", "required": ["kind", "value"], "properties": {
          "kind": { "const": "fixed" }, "value": { "type": "integer", "minimum": 0 }
        }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "classId", "column"], "properties": {
          "kind": { "const": "class-table" }, "classId": { "type": "string" },
          "column": { "type": "string" }, "fallback": { "type": "integer", "minimum": 0 }
        }, "additionalProperties": false }
      ]
    },
    "requirement": {
      "oneOf": [
        { "type": "object", "required": ["kind", "classId", "minimum"], "properties": {
          "kind": { "const": "class-level" }, "classId": { "type": "string" }, "minimum": { "type": "integer", "minimum": 1 }
        }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "ability", "minimum"], "properties": {
          "kind": { "const": "ability-score" }, "ability": { "enum": ["str", "dex", "con", "int", "wis", "cha"] },
          "minimum": { "type": "integer", "minimum": 1 }
        }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "selectionId", "optionId"], "properties": {
          "kind": { "const": "known-option" }, "selectionId": { "type": "string" }, "optionId": { "type": "string" }
        }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "spellId"], "properties": {
          "kind": { "const": "spell-known" }, "spellId": { "type": "string" }
        }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "featureId"], "properties": {
          "kind": { "const": "feature-owned" }, "featureId": { "type": "string" }
        }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "requirements"], "properties": {
          "kind": { "enum": ["all", "any"] }, "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" }, "minItems": 1 }
        }, "additionalProperties": false }
      ]
    },
    "selection": {
      "type": "object",
      "required": ["kind", "id", "optionSetId", "mode", "count"],
      "properties": {
        "kind": { "const": "selection" }, "id": { "type": "string" },
        "optionSetId": { "type": "string" }, "mode": { "enum": ["single", "multiple"] },
        "count": { "$ref": "#/$defs/progressionValue" },
        "allowDuplicates": { "type": "boolean", "default": false },
        "replacement": { "type": "object", "required": ["when", "count"], "properties": {
          "when": { "enum": ["class-level-gained", "long-rest", "manual"] },
          "count": { "type": "integer", "minimum": 1 }
        }, "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "required": ["kind", "id", "selectionId", "targetKind", "capacity"],
      "properties": {
        "kind": { "const": "assignment" }, "id": { "type": "string" },
        "selectionId": { "type": "string" }, "targetKind": { "enum": ["inventory-item", "creature", "spell"] },
        "capacity": { "$ref": "#/$defs/progressionValue" },
        "maxPerTarget": { "type": "integer", "minimum": 1, "default": 1 },
        "resetOn": { "enum": ["short-rest", "long-rest", "never"] },
        "eligibleItemTags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "resourcePool": {
      "type": "object",
      "required": ["kind", "id", "resourceId", "maximum", "recovery"],
      "properties": {
        "kind": { "const": "resource-pool" }, "id": { "type": "string" },
        "resourceId": { "type": "string" }, "maximum": { "$ref": "#/$defs/progressionValue" },
        "recovery": { "enum": ["short-rest", "long-rest", "dawn", "manual", "special"] }
      },
      "additionalProperties": false
    },
    "spellModifier": {
      "type": "object",
      "required": ["kind", "id", "optionSetId", "resourceId", "timing", "maxPerSpell"],
      "properties": {
        "kind": { "const": "spell-modifier" }, "id": { "type": "string" },
        "optionSetId": { "type": "string" }, "resourceId": { "type": "string" },
        "timing": { "const": "spell-cast" }, "maxPerSpell": { "type": "integer", "minimum": 1 },
        "replacement": { "type": "object", "properties": {
          "when": { "enum": ["class-level-gained", "manual"] }, "count": { "type": "integer", "minimum": 1 }
        }, "additionalProperties": false }
      },
      "additionalProperties": false
    }
  }
}
