{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reengine/schemas/item.schema.json",
  "title": "Canonical Item Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "ruleset"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/contentId" },
    "name": { "type": "string", "minLength": 1 },
    "ruleset": { "$ref": "common.schema.json#/$defs/ruleset" },
    "category": {
      "enum": ["weapon", "armor", "shield", "gear", "tool", "ammunition", "consumable", "magic-item"]
    },
    "baseItemId": { "$ref": "common.schema.json#/$defs/contentId" },
    "properties": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "source": { "$ref": "common.schema.json#/$defs/source" },
    "weaponProfile": {
      "type": "object",
      "required": ["weaponCategory", "weaponType", "damage"],
      "properties": {
        "weaponCategory": { "enum": ["simple", "martial"] },
        "weaponType": { "enum": ["melee", "ranged"] },
        "damage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["formula", "damageType"],
            "properties": {
              "formula": { "type": "string", "minLength": 1 },
              "damageType": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "range": {
          "type": "object",
          "required": ["normal"],
          "properties": {
            "normal": { "type": "integer", "minimum": 0 },
            "long": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "armorProfile": {
      "type": "object",
      "required": ["armorCategory", "baseAC", "dexterity", "stealthDisadvantage"],
      "properties": {
        "armorCategory": { "enum": ["light", "medium", "heavy", "shield"] },
        "baseAC": { "type": "integer", "minimum": 0 },
        "dexterity": { "enum": ["full", "capped", "none"] },
        "maxDexterityModifier": { "type": ["integer", "null"], "minimum": 0 },
        "strengthRequirement": { "type": "integer", "minimum": 0 },
        "stealthDisadvantage": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "dexterity": { "const": "capped" } },
            "required": ["dexterity"]
          },
          "then": {
            "required": ["maxDexterityModifier"],
            "properties": {
              "maxDexterityModifier": { "type": "integer", "minimum": 0 }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "category": { "const": "weapon" } }, "required": ["category"] },
      "then": { "required": ["weaponProfile"], "not": { "required": ["armorProfile"] } }
    },
    {
      "if": { "properties": { "category": { "const": "armor" } }, "required": ["category"] },
      "then": {
        "required": ["armorProfile"],
        "not": { "required": ["weaponProfile"] },
        "properties": {
          "armorProfile": {
            "properties": { "armorCategory": { "enum": ["light", "medium", "heavy"] } },
            "required": ["armorCategory"]
          }
        }
      }
    },
    {
      "if": { "properties": { "category": { "const": "shield" } }, "required": ["category"] },
      "then": {
        "required": ["armorProfile"],
        "not": { "required": ["weaponProfile"] },
        "properties": {
          "armorProfile": {
            "properties": { "armorCategory": { "const": "shield" } },
            "required": ["armorCategory"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "category": { "enum": ["gear", "tool", "ammunition", "consumable"] } },
        "required": ["category"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["weaponProfile"] },
            { "required": ["armorProfile"] }
          ]
        }
      }
    }
  ]
}
