{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reengine/schemas/class.schema.json",
  "title": "Canonical Class Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "ruleset",
    "hitDie",
    "features",
    "progression"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/contentId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "ruleset": {
      "$ref": "common.schema.json#/$defs/ruleset"
    },
    "hitDie": {
      "type": "integer",
      "enum": [
        6,
        8,
        10,
        12
      ]
    },
    "primaryAbilities": {
      "type": "array",
      "items": {
        "enum": [
          "str",
          "dex",
          "con",
          "int",
          "wis",
          "cha"
        ]
      },
      "uniqueItems": true
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "feature.schema.json"
      }
    },
    "progression": {
      "$ref": "#/$defs/progressionTable"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    }
  },
  "$defs": {
    "progressionTable": {
      "type": "object",
      "required": [
        "id",
        "classId",
        "rows"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/contentId"
        },
        "classId": {
          "$ref": "common.schema.json#/$defs/contentId"
        },
        "levelFromClassId": {
          "$ref": "common.schema.json#/$defs/contentId"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "level",
              "values"
            ],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "integer",
                    "string",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
