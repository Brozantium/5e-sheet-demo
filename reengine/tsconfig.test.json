{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2020",
    "rootDir": "src",
    "outDir": ".test-dist",
    "declaration": false,
    "sourceMap": false,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests/**", ".test-dist/**"]
}
